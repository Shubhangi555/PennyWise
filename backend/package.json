{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db": "node scripts/dev-db.mjs",
    "dev:local": "concurrently --kill-others --names db,api --prefix-colors magenta,cyan \"npm:db\" \"npm:dev\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node-dev --transpile-only src/migrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
